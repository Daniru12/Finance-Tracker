<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="Base.Theme.FinanceTracker" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/secondary_blue</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Background and content colors -->
        <item name="android:windowBackground">@color/background_light</item>
        <item name="android:textColor">@color/text_dark</item>
        <!-- Transparent status bar -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- EditText styling -->
        <item name="android:editTextStyle">@style/CustomEditTextStyle</item>
        <!-- CardView styling -->
        <item name="cardViewStyle">@style/CustomCardStyle</item>
    </style>

    <style name="SplashTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item> <!-- Replace splash_background with solid color -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="CustomEditTextStyle" parent="Widget.Material3.TextInputEditText.FilledBox">
        <item name="android:textColor">@color/text_dark</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:backgroundTint">@color/primary_green</item>
    </style>


    <style name="CustomCardStyle" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">8dp</item>
        <item name="cardElevation">4dp</item>
        <item name="cardBackgroundColor">@color/white</item>
    </style>

    <!-- Default App Theme -->
    <style name="Theme.FinanceTracker" parent="Base.Theme.FinanceTracker"/>

</resources>
